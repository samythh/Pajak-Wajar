# Hanya diperlukan bila pembacaan foto bukti potong (OCR) diaktifkan.
# Aplikasi tetap berjalan penuh tanpa kunci ini; jalur ketik manual tidak
# pernah bergantung padanya, dan route /api/ocr-bupot akan menjawab 503
# dengan pesan yang mengarahkan pengguna mengetik manual.
#
# Jangan memakai awalan NEXT_PUBLIC_ untuk kunci rahasia: variabel itu ikut
# terkirim ke peramban.
GEMINI_API_KEY=

# Opsional. Bawaan: gemini-3.6-flash
GEMINI_MODEL=
